{
  "name": "spotify.fm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "docker:up": "docker compose -f docker-compose.dev.yml up -d --build",
    "docker:down": "docker compose -f docker-compose.dev.yml down -v",
    "tunnel": "ssh -R 80:localhost:3000 ssh.localhost.run",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:int": "vitest run tests/integration",
    "test:e2e": "playwright test tests/e2e"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "mongoose": "^9.10.2",
    "next": "^16.2.7",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "redis": "^5.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.1.6",
    "msw": "^2.14.6",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
